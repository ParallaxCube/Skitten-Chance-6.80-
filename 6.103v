-- Create a new tab for Stats
local StatsTab = Window:CreateTab("Stats", "stats") -- Title, Image

-- Create a new section for the stats display
local StatsSection = StatsTab:CreateSection("Current Stats")

-- Create labels for the stats we want to track (Initially hidden)
local PingLabel = StatsTab:CreateLabel("Ping: Loading...")
local TargetModeLabel = StatsTab:CreateLabel("Target Mode: Loading...")
local MovementThresholdLabel = StatsTab:CreateLabel("Movement Threshold: Loading...")
local AimDurationLabel = StatsTab:CreateLabel("Aim Duration: Loading...")
local ClosestDistanceLabel = StatsTab:CreateLabel("Closest Distance to Disable: Loading...")
local PredictionModeLabel = StatsTab:CreateLabel("Prediction Mode: Loading...")

-- Hide the labels initially
PingLabel:SetVisible(false)
TargetModeLabel:SetVisible(false)
MovementThresholdLabel:SetVisible(false)
AimDurationLabel:SetVisible(false)
ClosestDistanceLabel:SetVisible(false)
PredictionModeLabel:SetVisible(false)

-- Function to update the stats and make them visible
local function updateStats()
    -- Get ping value
    local pingMs = statsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    local pingSec = pingMs / 1000
    PingLabel:SetText("Ping: " .. string.format("%.2f", pingSec) .. " seconds")
    
    -- Get the current target mode (HRP, Snap, or Cam)
    TargetModeLabel:SetText("Target Mode: " .. TargetMode)
    
    -- Show the current movement threshold
    MovementThresholdLabel:SetText("Movement Threshold: " .. string.format("%.2f", chanceMovementThreshold) .. " studs")
    
    -- Show the current aim duration
    AimDurationLabel:SetText("Aim Duration: " .. string.format("%.2f", chanceAimDuration) .. " seconds")
    
    -- Show the closest distance to disable (closeness value)
    ClosestDistanceLabel:SetText("Closest Distance to Disable: " .. string.format("%.2f", ChanceClosenesstoDisable) .. " studs")
    
    -- Show the current prediction mode
    PredictionModeLabel:SetText("Prediction Mode: " .. chancePredictionMode)
    
    -- Make labels visible after updating them
    PingLabel:SetVisible(true)
    TargetModeLabel:SetVisible(true)
    MovementThresholdLabel:SetVisible(true)
    AimDurationLabel:SetVisible(true)
    ClosestDistanceLabel:SetVisible(true)
    PredictionModeLabel:SetVisible(true)
end

-- Create a button to toggle stats visibility
local StatsButton = StatsTab:CreateButton({
    Name = "Toggle Stats",
    Callback = function()
        -- If the stats are visible, hide them; otherwise, update and show them
        if PingLabel:IsVisible() then
            -- Hide stats
            PingLabel:SetVisible(false)
            TargetModeLabel:SetVisible(false)
            MovementThresholdLabel:SetVisible(false)
            AimDurationLabel:SetVisible(false)
            ClosestDistanceLabel:SetVisible(false)
            PredictionModeLabel:SetVisible(false)
        else
            -- Update stats and show them
            updateStats()
        end
    end
})







 

