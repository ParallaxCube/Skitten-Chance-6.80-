local chanceAimTargets = {"Slasher","c00lkidd","JohnDoe","1x1x1x1","Noli","Sixer","Nosferatu"}
local chanceAimAnimationIds = {"111384272984267", "133491532453922", "133607163653602", "131189930305001", "76649505662612", "103601716322988", "86371356500204", "74687476269316", "111512633767170", "81698196845041"}

-- UI State Variables
local chanceActive, chanceAiming, forceAimActive = false, false, false
local autoPredictionEnabled, alwaysShowPredictionBox, showPredictionBox = false, false, false
local VerticalOffset, SnapPower, extraStuds = 0, 1.0, 0
local TargetMode = "Snap"
local HRPSmoothing, CAMSmoothing = 0.7, 0.7
local chanceMovementThreshold = 0.7
local ChanceClosenesstoDisable = 6
local chanceAimDuration = 1.6
