-- [[ 10. TARGET & PREDICTION FUNCTIONS ]]

local function chanceFindValidTarget()
    local kFolder = getKillersFolder() 
    if not kFolder then return nil end

    for _, name in ipairs(chanceAimTargets) do
        local target = kFolder:FindFirstChild(name)
        if target then
            local hrp = target:FindFirstChild("HumanoidRootPart")
            local hum = target:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                return hrp
            end
        end
    end
    return nil
end

local function chancePredictPosition(targetHRP)
    if not targetHRP or not statsService:FindFirstChild("Network") then 
        return targetHRP.Position 
    end
    
    local ping = 0
    pcall(function()
        ping = statsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    local velocity = targetHRP.AssemblyLinearVelocity
    
    if velocity.Magnitude > (tonumber(chanceMovementThreshold) or 0.5) then
        local pingPred = targetHRP.Position + (velocity * ping)
        
        local extra = extraStuds
        if chancePredictionMode == "Custom + Ping" then
            extra = tonumber(CustomStudsAddedToPing) or 0
        end
        
        return pingPred + (velocity.Unit * extra)
    end
    return targetHRP.Position
end

local function chanceCheckAimAnimation()
    if not chancePlayerHumanoid or chanceActiveTrack then return false end

    for _, track in ipairs(chancePlayerHumanoid:GetPlayingAnimationTracks()) do
        local id = track.Animation.AnimationId:match("%d+")
        if id and table.find(chanceAimAnimationIds, id) then
            chanceActiveTrack = track
            track.Stopped:Once(function()
              chanceActiveTrack = nil 
              end)
            return true
        end
    end
    return false
end

