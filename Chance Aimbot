        local duration = tonumber(chanceAimDuration) or 1.6
        local remaining = math.max(0, duration - elapsed)
        
        -- Update UI Progress Bars
        local progress = remaining / duration
        if showProgressBar then
            MainBar.Visible = true
            ProgressBar.Size = UDim2.new(progress, 0, 1, 0)
            
            AimBox.Visible = true
            AimBarInner.Size = UDim2.new(progress, -10, 0, 2)
            AimText.Text = string.format("LOCKED: %.1fs", remaining)
        end

        -- Stop conditions
        if not targetHRP or (remaining <= 0 and not forceAimActive) then
            chanceAiming = false
            MainBar.Visible = false
            AimBox.Visible = false
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = true end
            return
        end

        local dist = (targetHRP.Position - chancePlayerHRP.Position).Magnitude
        if dist >= (ChanceClosenesstoDisable or 0) then
            ExecuteAim(predicted, dt)
        end
    else
        -- Hide UI if not aiming
        MainBar.Visible = false
        AimBox.Visible = false
    end
end)
-- the end of main aim loop

