local function ApplyAggressiveSpoof(targetMode)
    pcall(function()
        local netModule = replicatedStorage:FindFirstChild("Modules"):FindFirstChild("Network")
        if netModule then
            local Network = require(netModule)
            if Network and type(Network.FireServerConnection) == "function" then
                Network:FireServerConnection("SetDevice", "REMOTE_EVENT", targetMode)
            end
        end
    end)
    if getloadedmodules then
        for _, module in ipairs(getloadedmodules()) do
            pcall(function()
                local env = require(module)
                if type(env) == "table" then
                    if rawget(env, "Device") then env.Device = targetMode end
                    if rawget(env, "DeviceType") then env.DeviceType = targetMode end
                    if rawget(env, "CurrentDevice") then env.CurrentDevice = targetMode end
                    if rawget(env, "IsMobile") ~= nil then env.IsMobile = (targetMode ~= "PC") end
                    if rawget(env, "isMobile") ~= nil then env.isMobile = (targetMode ~= "PC") end
                    if rawget(env, "IsPC") ~= nil then env.IsPC = (targetMode == "PC") end
                    if rawget(env, "isPC") ~= nil then env.isPC = (targetMode == "PC") end
                    if rawget(env, "Value") and (env.Value == "Mobile" or env.Value == "PC" or env.Value == "Console") then
                        env.Value = targetMode
                    end
                end
            end)
        end
    end
end

task.spawn(function()
