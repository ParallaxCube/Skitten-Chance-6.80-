                    local dist = (hrp.Position - chancePlayerHRP.Position).Magnitude
                    marker.DistanceText.Text = math.floor(dist)
                    marker.Enabled = (dist > 1 and dist < 100)
                end
            end
        else
            for _, m in ipairs(killerMarkerFolder:GetChildren()) do m.Enabled = false end
        end
    end

    -- 2. AIMBOT PREP
    if not chanceActive or not chancePlayerHRP then 
        predictionMarker.Transparency = 1
        AimBox.Visible = false
        return 
    end

    local targetHRP = chanceFindValidTarget()
    local predicted = targetHRP and getUnifiedPrediction(targetHRP, TargetMode)

    -- 3. TRIGGER LOGIC (Animation Start)
    if not chanceAiming and (chanceCheckAimAnimation() or forceAimActive) then
        chanceLastTriggerTime = tick()
        chanceAiming = true
    end

    -- 4. VISUAL PREDICTION BOX
    if predicted and (alwaysShowPredictionBox or (showPredictionBox and chanceAiming)) then
        local boxPos = predicted + Vector3.new(0, VerticalOffset or 0, 0)
        predictionMarker.CFrame = CFrame.new(boxPos) * (targetHRP.CFrame - targetHRP.Position)
        predictionMarker.Transparency = predBoxTransparency
    else
        predictionMarker.Transparency = 1
    end

    -- 5. THE 5-MODE AIM EXECUTION
    if chanceAiming and predicted then
        local elapsed = tick() - chanceLastTriggerTime
        local remaining = math.max(0, chanceAimDuration - elapsed)
        
        -- Stop aiming if target lost or time ran out
        if not targetHRP or (remaining <= 0 and not forceAimActive) then
            chanceAiming = false
            AimBox.Visible = false
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = true end
            return
        end

        -- LOCK TRACKER GUI (Matching Ping/FPS Box Style)
        if showProgressBar then
            AimBox.Visible = true
            local percentage = math.clamp(remaining / chanceAimDuration, 0, 1)
            
            -- Update Text and progress line
            AimText.Text = string.format("Lock: %.1fs", remaining)
            AimBarInner.Size = UDim2.new(percentage, -10, 0, 2)
            
            -- Color Shift: Blue -> Green -> Red
            local uiColor = Color3.fromHSV(percentage * 0.35, 0.8, 1)
            AimBox.BorderColor3 = uiColor
            AimText.TextColor3 = uiColor
            AimBarInner.BackgroundColor3 = uiColor
        else
            AimBox.Visible = false
        end

        -- Safety Distance Check & Execution
        local dist = (targetHRP.Position - chancePlayerHRP.Position).Magnitude
        if dist >= ChanceClosenesstoDisable then
            -- This snap is instant for your hitboxes
            ExecuteAim(predicted, dt)
        end
    else
        -- Hide the box if we aren't actively aiming
        AimBox.Visible = false
    end
end)
-- the end of main aim loop

