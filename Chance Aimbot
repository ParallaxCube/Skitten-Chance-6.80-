-- Scans the folder and returns the best valid killer to aim at
local function chanceFindValidTarget()
    local kFolder = getKillersFolder() 
    if not kFolder then return nil end
    
    local closestTarget = nil
    local shortestDist = math.huge

    for _, name in ipairs(chanceAimTargets) do
        local target = kFolder:FindFirstChild(name)
        if target then
            local hrp = target:FindFirstChild("HumanoidRootPart")
            local hum = target:FindFirstChild("Humanoid")
            
            -- Ensure they exist and are alive
            if hrp and hum and hum.Health > 0 then
                
                -- Smart switch tracks the closest guy, normal targets the first found
                if SmartSwitch and chancePlayerHRP then
                    local dist = (hrp.Position - chancePlayerHRP.Position).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closestTarget = hrp
                    end
                else
                    return hrp
                end
            end
        end
    end
    return closestTarget
end

-- Calculates where the crosshair should actually go
local function getUnifiedPrediction(targetHRP)
    if not targetHRP or not chancePlayerHRP then 
        return targetHRP and targetHRP.Position or nil 
    end
    
    local velocity = targetHRP.AssemblyLinearVelocity
    local latency = getPing()

    -- Gate check: If they are moving too slowly, just aim at their body
    if velocity.Magnitude < (tonumber(chanceMovementThreshold) or 0.7) then 
        return targetHRP.Position 
    end
    
    -- Step 1: Base ping latency prediction
    local predicted = targetHRP.Position + (velocity * latency)

    -- Step 2: Custom Developer Leads (Your extra studs)
    local extra = extraStuds
    if chancePredictionMode == "Custom + Ping" then 
        extra = tonumber(CustomStudsAddedToPing) or 0 
    end
    
    -- Add the lead in the direction they are moving
    predicted = predicted + (velocity.Unit * extra)
    
    return predicted
end

-- Checks if your player is swinging a weapon
local function chanceCheckAimAnimation()
    if not chancePlayerHumanoid or chanceActiveTrack then 
        return false 
    end
    
    for _, track in ipairs(chancePlayerHumanoid:GetPlayingAnimationTracks()) do
        local id = track.Animation.AnimationId:match("%d+")
        
        -- If the animation matches our list, lock on!
        if id and table.find(chanceAimAnimationIds, id) then
            chanceActiveTrack = track
            track.Stopped:Once(function() 
                chanceActiveTrack = nil 
            end)
            return true
        end
    end
    return false
end

