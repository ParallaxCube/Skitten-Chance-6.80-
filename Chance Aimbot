local HUDColors = {
    Good = Color3.fromRGB(100, 255, 100),
    Warning = Color3.fromRGB(255, 200, 100),
    Bad = Color3.fromRGB(255, 100, 100)
}

local hudUpdateTimer = 0
local hudUpdateInterval = 0.5 
local framesRendered = 0

runService.RenderStepped:Connect(function(dt)
    framesRendered += 1
    hudUpdateTimer += dt

    if hudUpdateTimer >= hudUpdateInterval then
        local fps = math.floor(framesRendered / hudUpdateTimer)
        
        framesRendered = 0
        hudUpdateTimer = 0

        if not (PingBox.Visible or FpsBox.Visible or MemBox.Visible) then return end

        local ping, mem = 0, 0
        pcall(function()
            ping = math.floor(statsService.Network.ServerStatsItem["Data Ping"]:GetValue()) 
            mem = math.floor(statsService:GetTotalMemoryUsageMb())
        end)

        if PingBox.Visible then  
            PingText.Text = "Ping: " .. ping 
            PingBox.BorderColor3 = (ping > 150) and HUDColors.Bad or HUDColors.Good
            PingText.TextColor3 = PingBox.BorderColor3
        end 

        if FpsBox.Visible then   
            FpsText.Text = "FPS: " .. fps 
            FpsBox.BorderColor3 = (fps < 30) and HUDColors.Bad or HUDColors.Good
            FpsText.TextColor3 = FpsBox.BorderColor3
        end 

        if MemBox.Visible then   
