-- // 4. CORE ENGINE FUNCTIONS
local function getKillersFolder() 
    local pFolder = workspaceService:FindFirstChild("Players") 
    return pFolder and pFolder:FindFirstChild("Killers") 
end

local function getUnifiedPrediction(targetHRP)
    if not targetHRP or not chancePlayerHRP then return nil end
    
    local ping = statsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    local modeOffset = (TargetMode == "Snap" and pingPredictionSnap) or (TargetMode == "HRP" and pingPredictionHRP) or (TargetMode == "Cam" and pingPredictionCam) or (TargetMode == "ASnap" and pingPredictionASnap) or 0
    
    local latency = ping + modeOffset
    local velocity = targetHRP.AssemblyLinearVelocity
    
    if velocity.Magnitude < chanceMovementThreshold then return targetHRP.Position end
    
    local predicted = targetHRP.Position + (velocity * latency)
    if extraStuds > 0 then predicted = predicted + (velocity.Unit * extraStuds) end
    
    return predicted
end

local function ExecuteAim(predicted, dt)
    if not chancePlayerHRP or not chancePlayerHumanoid then return end
    local hrpPos = chancePlayerHRP.Position
    local adjustedPredicted = predicted + Vector3.new(0, VerticalOffset, 0)
    local flatTarget = Vector3.new(adjustedPredicted.X, hrpPos.Y, adjustedPredicted.Z)

    if TargetMode == "Snap" or TargetMode == "ASnap" then
        chancePlayerHumanoid.AutoRotate = false
        local targetCF = CFrame.lookAt(hrpPos, flatTarget)
        local lerpVal = (TargetMode == "Snap") and SnapPower or math.clamp(HRPSmoothing, 0.1, 0.5)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, lerpVal)
    elseif TargetMode == "Cam" or TargetMode == "ACam" then
        chancePlayerHumanoid.AutoRotate = true
        local speedMult = (TargetMode == "ACam") and 1.3 or 1.0
        local targetCF = CFrame.lookAt(camera.CFrame.Position, adjustedPredicted)
        camera.CFrame = camera.CFrame:Lerp(targetCF, math.min((CAMSmoothing * speedMult) * dt * 60, 1))
    end
end

-- // 5. UI COMPONENTS (Hardware & Prediction Box)
local PerfGui = Instance.new("ScreenGui", coreGui)
local predictionMarker = Instance.new("Part", workspace)
predictionMarker.Size, predictionMarker.Anchored, predictionMarker.CanCollide = Vector3.new(1.5, 8, 1.5), true, false
predictionMarker.Material, predictionMarker.Transparency = Enum.Material.Neon, 1

-- // 6. MAIN SYSTEM LOOP
runService.Heartbeat:Connect(function(dt)
    if not chanceActive or not chancePlayerHRP then 
        predictionMarker.Transparency = 1
        return 
    end

    -- Trigger Logic (Anim detection)
    local isAnimating = false
    if chancePlayerHumanoid then
        for _, track in ipairs(chancePlayerHumanoid:GetPlayingAnimationTracks()) do
            local id = track.Animation.AnimationId:match("%d+")
            if id and table.find(chanceAimAnimationIds, id) then isAnimating = true break end
        end
    end

    if not chanceAiming and (isAnimating or forceAimActive) then
        chanceLastTriggerTime = tick()
        chanceAiming = true
    end

    if chanceAiming then
        local kFolder = getKillersFolder()
        local targetHRP = nil
        if kFolder then
            for _, name in ipairs(chanceAimTargets) do
                local t = kFolder:FindFirstChild(name)
                if t and t:FindFirstChild("HumanoidRootPart") and t.Humanoid.Health > 0 then
                    targetHRP = t.HumanoidRootPart break
                end
            end
        end

        local elapsed = tick() - chanceLastTriggerTime
        if not targetHRP or (elapsed > chanceAimDuration and not forceAimActive) then
            chanceAiming = false
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = true end
            predictionMarker.Transparency = 1
            return
        end

        local predicted = getUnifiedPrediction(targetHRP)
        if predicted then
            -- Visual Box
            if alwaysShowPredictionBox or (showPredictionBox and chanceAiming) then
                predictionMarker.CFrame = CFrame.new(predicted + Vector3.new(0, VerticalOffset, 0))
                predictionMarker.Transparency = predBoxTransparency
            end
            
            -- Aiming
            local dist = (targetHRP.Position - chancePlayerHRP.Position).Magnitude
            if dist > ChanceClosenesstoDisable then
                ExecuteAim(predicted, dt)
            end
        end
    else
        predictionMarker.Transparency = 1
    end
end)

