VaultTab:CreateParagraph({Title = "Notice",
    Content = "These settings override your base V19 math ONLY when enabled above. BackSnap and VCurve work under legacy too."})

-------------------------------------------------------------------------------
-- Load config first so all variables have their saved values,
-- THEN build the Info tab so it displays your real loaded state.
-------------------------------------------------------------------------------
Rayfield:LoadConfiguration()

task.spawn(function()
    task.wait(0.15)   -- let LoadConfiguration callbacks finish updating vars

    local InfoTab = Window:CreateTab("Info", "info")
    InfoTab:CreateSection("Aim Settings")
    InfoTab:CreateParagraph({Title = "Target Mode",
        Content = "Active: " .. TargetMode .. "\nHow your character rotates to aim. BackSnap = look away then 180 flip. VCurve = cubic ease HRP. AsSnap = lerp then hard snap."})
    InfoTab:CreateParagraph({Title = "Aim Lock Duration",
        Content = string.format("Active: %.1fs\nHow long the aim lock lasts before disarming.", chanceAimDuration)})
    InfoTab:CreateParagraph({Title = "Snap Power",
        Content = string.format("Active: %.2f\nThe lerp alpha used during the hard-snap phase. 1.0 = instant.", SnapPower)})
    InfoTab:CreateParagraph({Title = "HRP Smoothing",
        Content = string.format("Active: %.2f\nLerp speed for HRP rotation. Lower = slower/smoother. Also controls BackSnap look-away speed.", HRPSmoothing)})
    InfoTab:CreateParagraph({Title = "Camera Smoothing",
        Content = string.format("Active: %.2f\nLerp speed for camera modes (Cam, ACam, ACSnap).", CAMSmoothing)})
    InfoTab:CreateParagraph({Title = "AimFOV / Max Distance",
        Content = string.format("AimFOV: %d studs  |  MaxSnap: %d studs\nAim only fires when target is within AimFOV. RSnap/ACSnap use MaxSnap for force scaling.", AimFOV, MaxSnapDistance)})
    InfoTab:CreateParagraph({Title = "Safety Closeness",
        Content = string.format("Active: %d studs\nAim disarms when target is closer than this. 0 = disabled.", ChanceClosenesstoDisArm)})
    InfoTab:CreateParagraph({Title = "Reaction Delay",
        Content = string.format("Active: %.2fs\nHow long after animation trigger before aim fires.", ReactionDelay)})
    InfoTab:CreateSection("Prediction")
    InfoTab:CreateParagraph({Title = "Prediction Mode",
        Content = "Active: " .. chancePredictionMode .. "\nControls how far ahead of target position the aim leads. Ping Only = uses network latency. Custom + Ping = adds your custom studs on top."})
    InfoTab:CreateParagraph({Title = "Extra Prediction Studs",
        Content = string.format("Active: %.3f studs\nAdded to ping-based prediction. Only used in Custom + Ping mode.", extraStuds)})
    InfoTab:CreateSection("Movement / TPWalk")
    InfoTab:CreateParagraph({Title = "TPWalk",
        Content = string.format(
            "Enabled: %s\nSpeed: %.4f studs/frame\nApprox: %.3f studs/s at 60fps\n\nThis adds extra movement on top of your normal WalkSpeed every Heartbeat frame. 0.27 s/f = ~16 studs/s (same as default WalkSpeed).",
            tostring(tpWalkEnabled), tpWalkSpeed, tpWalkSpeed * 60)})
    InfoTab:CreateSection("ESP")
    InfoTab:CreateParagraph({Title = "Killer ESP",
        Content = string.format("Enabled: %s\nFill visibility: %d%%\nColor: pink-red by default. Outline shares fill color. Never applied to yourself.", tostring(killerESPEnabled), math.floor((1 - KillerFillAlpha) * 100))})
    InfoTab:CreateParagraph({Title = "Survivor ESP",
        Content = string.format("Enabled: %s\nFill visibility: %d%%\nColor: green by default. Never applied to yourself.", tostring(playerESPEnabled), math.floor((1 - PlayerFillAlpha) * 100))})
    InfoTab:CreateSection("VCurve")
    InfoTab:CreateParagraph({Title = "VCurve State",
        Content = string.format("HRP Weight: %.2f  |  Curve Exp: %d\nVel Scale: %.1fx  |  Early Snap: %.0f%% of timer\nActive when Target Mode = VCurve.", VCurve_HRPWeight, VCurve_CurveExp, VCurve_VelScale, VCurve_EarlySnapPct * 100)})
    InfoTab:CreateSection("BackSnap")
    InfoTab:CreateParagraph({Title = "BackSnap State",
        Content = string.format("Snap Window: %.2fs before end\nPhase 1 = look away (uses HRPSmoothing). Phase 2 = 180 snap (uses SnapPower). Active when Target Mode = BackSnap.", BackSnap_SnapWindow)})
    InfoTab:CreateSection("Vault / Legacy")
    InfoTab:CreateParagraph({Title = "Legacy Engine",
        Content = string.format("Override active: %s\nEngine: %s\nInfinite Range: %s", tostring(Vault_EnableLegacy), Vault_SelectedEngine, tostring(Vault_InfiniteRange))})
end)
