local function getUnifiedPrediction(targetHRP, mode)
    if not targetHRP or not chancePlayerHRP then return targetHRP and targetHRP.Position or nil end
    local ping = statsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    local velocity = targetHRP.AssemblyLinearVelocity
    if velocity.Magnitude < chanceMovementThreshold then return targetHRP.Position end
    return targetHRP.Position + (velocity * ping) + (velocity.Unit * extraStuds)
end [cite: 10, 11, 12]

local function chanceFindValidTarget()
    local kFolder = getKillersFolder()
    if not kFolder then return nil end
    for _, name in ipairs(chanceAimTargets) do
        local target = kFolder:FindFirstChild(name)
        if target and target:FindFirstChild("HumanoidRootPart") and target.Humanoid.Health > 0 then
            return target.HumanoidRootPart
        end
    end
    return nil
end [cite: 14, 15]

local function ExecuteAim(predicted, dt)
    if not chancePlayerHRP then return end
    local adjustedPredicted = predicted + Vector3.new(0, VerticalOffset, 0)
    if TargetMode == "Snap" or TargetMode == "ASnap" then
        chancePlayerHumanoid.AutoRotate = false
        local targetCF = CFrame.lookAt(chancePlayerHRP.Position, Vector3.new(adjustedPredicted.X, chancePlayerHRP.Position.Y, adjustedPredicted.Z))
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
    elseif TargetMode == "Cam" then
        camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, adjustedPredicted), CAMSmoothing)
    end
end [cite: 8, 9]

-- [[ 6. MAIN LOOP ]]
runService.Heartbeat:Connect(function(dt)
    if not chanceActive or not chancePlayerHRP then 
        MainBar.Visible = false
        AimBox.Visible = false
        return 
    end

    local targetHRP = chanceFindValidTarget()
    local predicted = getUnifiedPrediction(targetHRP, TargetMode)

    if not chanceAiming and (forceAimActive) then -- Simplified trigger
        chanceLastTriggerTime = tick()
        chanceAiming = true
    end

    if chanceAiming and predicted then
        local elapsed = tick() - chanceLastTriggerTime
        local remaining = math.max(0, chanceAimDuration - elapsed)
        local progress = remaining / chanceAimDuration
        
        if showProgressBar then
            MainBar.Visible = true
            ProgressBar.Size = UDim2.new(progress, 0, 1, 0)
            AimBox.Visible = true
            AimText.Text = string.format("LOCKED: %.1fs", remaining)
        end

        if remaining <= 0 and not forceAimActive then
            chanceAiming = false
            MainBar.Visible = false
            AimBox.Visible = false
        else
            ExecuteAim(predicted, dt)
        end
    else
        MainBar.Visible = false
        AimBox.Visible = false
    end
end)

