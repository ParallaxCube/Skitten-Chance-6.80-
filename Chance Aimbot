    if not checkcaller() then
        if self == GuiService or self == userInputService then
            if method == "GetPlatform" then
                if spoofMode == "PC" then return Enum.Platform.Windows end
                if spoofMode == "Mobile" then return Enum.Platform.IOS end
                if spoofMode == "Console" then return Enum.Platform.XBoxOne end
