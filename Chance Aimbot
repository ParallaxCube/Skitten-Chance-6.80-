                if AimText then
                    AimText.Text = string.format("LOCKED: %.1fs", remaining)
                end
            else
                AimBox.Visible = false
            end
        end

        if not targetHRP or (remaining <= 0 and not forceAimActive) then
            chanceAiming = false
            if MainBar then MainBar.Visible = false end
            if AimBox then AimBox.Visible = false end
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = true end
            
            for _, m in ipairs(killerMarkerFolder:GetChildren()) do
                if m:FindFirstChild("LockDurationText") then
                    m.LockDurationText.Visible = false
                end
            end
            return
        end

        -- [[ UPDATED: TIED TO ESP PANEL TOGGLE ]]
        -- -- LINE if targetHRP and targetHRP.Parent then
        if showAimTimerESP and targetHRP and targetHRP.Parent then
            local markerName = targetHRP.Parent.Name .. "Marker"
            local marker = killerMarkerFolder:FindFirstChild(markerName)
            if marker and marker:FindFirstChild("LockDurationText") then
                marker.LockDurationText.Text = string.format("LOCKED: %.1fs", remaining)
                marker.LockDurationText.Visible = true
            end
        end

        local dist = (targetHRP.Position - chancePlayerHRP.Position).Magnitude
        if dist >= (ChanceClosenesstoDisArm or 0) then
            ExecuteAim(predicted, dt)
        end
    else
        if MainBar then MainBar.Visible = false end
        if AimBox then AimBox.Visible = false end
        
        for _, m in ipairs(killerMarkerFolder:GetChildren()) do
