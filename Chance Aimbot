-- [[ 4. TARGET FINDING (The Safe Version) ]]
local function chanceFindValidTarget()
    local pFolder = workspaceService:FindFirstChild("Players")
    local kFolder = pFolder and pFolder:FindFirstChild("Killers")
    if not kFolder then return nil end
    
    for _, killer in ipairs(kFolder:GetChildren()) do
        if targetLookup[killer.Name] and killer:FindFirstChild("HumanoidRootPart") then
            return killer.HumanoidRootPart
        end
    end
    return nil
end

-- [[ 5. AIM MODES (Declared BEFORE ExecuteAim) ]]
local function CamMode(targetHRP, hrpPos, predicted, dt)
    local camPos = camera.CFrame.Position
    local direction = (predicted - camPos).Unit
    local camCF = CFrame.new(camPos, camPos + direction)
    camera.CFrame = camera.CFrame:Lerp(camCF, math.min(CAMSmoothing * dt * 60, 1))
end


local function SnapMode(targetHRP, hrpPos, predicted)
    local flatTarget = Vector3.new(predicted.X, hrpPos.Y, predicted.Z)
    chancePlayerHRP.CFrame = CFrame.lookAt(hrpPos, flatTarget)
end

local function HRPMode(targetHRP, hrpPos, predicted, dt, customSmooth)
    local smooth = customSmooth or HRPSmoothing
    local targetCF = CFrame.lookAt(hrpPos, predicted)
    chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, math.min(smooth * dt * 60, 1))
end

local function ASnapMode(targetHRP, hrpPos, predicted)
    local targetCF = CFrame.lookAt(hrpPos, predicted)
    chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, math.clamp(HRPSmoothing,0.15,0.45))
end

local function ACamMode(targetHRP, hrpPos, predicted, dt)
    if not targetHRP then return end-- Get the current camera position
    local camPos = camera.CFrame.Position-- Calculate the target's predicted position (to lock the camera onto it)
    local cameraLookAt = predicted + Vector3.new(0, 2, 0)  -- Adjusting to focus on the target's head-- Calculate the direction to look at the target
    local direction = (cameraLookAt - camPos).Unit-- Smoothly rotate the camera to aim at the predicted target position
    local camCF = CFrame.new(camPos, cameraLookAt) * CFrame.Angles(0, math.atan2(-direction.X, -direction.Z), 0)-- Apply the smooth camera rotation (camera position remains fixed relative to the character)
    camera.CFrame = camera.CFrame:Lerp(camCF, math.min(CAMSmoothing * dt * 60, 1)) -- Keep the player’s humanoid root part rotating towards the predicted target
    local lookAtAngle = CFrame.new(hrpPos, predicted).LookVector
    chancePlayerHRP.CFrame = CFrame.new(hrpPos, hrpPos + lookAtAngle)
end

-- [[ 6. EXECUTION LOGIC ]]
-- Update ExecuteAim to include ACam
local function ExecuteAim(predicted, dt)
    if not chancePlayerHRP then return end
    local hrpPos = chancePlayerHRP.Position
    
    if TargetMode == "Snap" then
        local dir = (predicted - hrpPos).Unit
        local yaw = math.atan2(-dir.X, -dir.Z)
        chancePlayerHRP.CFrame = CFrame.new(hrpPos) * CFrame.Angles(0, yaw, 0)
    elseif TargetMode == "Cam" then
        CamMode(nil, hrpPos, predicted, dt)
    elseif TargetMode == "ASnap" then
        ASnapMode(nil, hrpPos, predicted)
    elseif TargetMode == "ACam" then
        ACamMode(nil, hrpPos, predicted, dt)  -- ACam mode logic
    else
        HRPMode(nil, hrpPos, predicted, dt)
    end
end

-- [[ 7. PREDICTION ENGINE ]]
local function getUnifiedPrediction(targetHRP, mode)
    if not targetHRP then return nil end
    
    local ping = statsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    local modeOffset = (mode == "Snap" and pingPredictionSnap) 
                    or (mode == "HRP" and pingPredictionHRP) 
                    or (mode == "Cam" and pingPredictionCam) 
                    or (mode == "ASnap" and pingPredictionASnap) 
                    or 0
    
    local latency = ping + modeOffset
    local velocity = targetHRP.AssemblyLinearVelocity
    
    if velocity.Magnitude < chanceMovementThreshold then return targetHRP.Position end

    local predicted = targetHRP.Position + (velocity * latency)

    if mode == "ASnap" then
        local lastVel = targetHRP:GetAttribute("LastVelocity") or velocity
        local accel = velocity - lastVel
        targetHRP:SetAttribute("LastVelocity", velocity)
        predicted += accel * (latency * 0.5)
        
        if autoPredictionEnabled and chancePlayerHRP then
            local dist = (targetHRP.Position - chancePlayerHRP.Position).Magnitude
            predicted += velocity * math.clamp(dist * 0.0025, 0, 0.35)
        end
    end

    if extraStuds > 0 then
        predicted += velocity.Unit * extraStuds
    end

    return predicted
end

