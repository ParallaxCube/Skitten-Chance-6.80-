    markerTimer += dt
    if markerTimer >= 0.1 then
        markerTimer = 0
        local kFolder = workspaceService:FindFirstChild("Players") and workspaceService.Players:FindFirstChild("Killers")
        if killerMarkerEnabled and chancePlayerHRP and kFolder then
            for _, killer in ipairs(kFolder:GetChildren()) do
                local hrp = killer:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local marker = killerMarkerFolder:FindFirstChild(killer.Name.."Marker") or createKillerMarker(hrp, killer.Name)
                    local dist = (hrp.Position - chancePlayerHRP.Position).Magnitude
                    if marker:FindFirstChild("DistanceText") then marker.DistanceText.Text = math.floor(dist) end
                    marker.Enabled = (dist > 1 and dist < 100)
                end
            end
        else
            for _, m in ipairs(killerMarkerFolder:GetChildren()) do m.Enabled = false end
        end
    end

   -- 2. Stabilized Aimbot & Visual Logic
    if not chanceActive or not chancePlayerHRP then 
        predictionMarker.Transparency = 1 
        return 
    end

    -- Find the target early so the visual box can use it at any time
    local targetHRP = chanceFindValidTarget()
    local predicted = nil
    
    if targetHRP then
        predicted = getUnifiedPrediction(targetHRP, TargetMode)
    end

    -- VISUAL LOGIC: Update the prediction box
    if predicted and (alwaysShowPredictionBox or (showPredictionBox and chanceAiming)) then
        -- The box shows if "Always Show" is toggled, OR if the normal show is toggled AND we are aiming
        predictionMarker.CFrame = CFrame.new(predicted) * targetHRP.CFrame.Rotation
        predictionMarker.Transparency = 0.5
    else
        predictionMarker.Transparency = 1
    end

    -- AIMING LOGIC: Handle the actual aimbot state
    if not chanceAiming and (chanceCheckAimAnimation() or forceAimActive) then
        chanceLastTriggerTime = tick()
        chanceAiming = true
    end

    if chanceAiming then
        local elapsed = tick() - chanceLastTriggerTime

        -- Stop aiming if target is lost or time expires
        if not targetHRP or (not forceAimActive and elapsed > chanceAimDuration) then
            chanceAiming = false
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = true end
            return
        end

        -- Safety measure: stop aiming if they get too close
        if (targetHRP.Position - chancePlayerHRP.Position).Magnitude < ChanceClosenesstoDisable then
            return 
        end

        -- Execute the aim
        if predicted then
            if chancePlayerHumanoid then 
                if TargetMode == "Cam" or TargetMode == "ACam" then
                    chancePlayerHumanoid.AutoRotate = true
                else
                    chancePlayerHumanoid.AutoRotate = false 
                end
            end
            
            ExecuteAim(predicted, dt)
        end
    end
end)
