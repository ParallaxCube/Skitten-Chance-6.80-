        predictionMarker.CFrame = CFrame.new(boxPos)
        predictionMarker.Transparency = predBoxTransparency or 0.5
    else
        predictionMarker.Transparency = 1
    end

    if chanceAiming and predicted then
        local elapsed = tick() - chanceLastTriggerTime
        local duration = tonumber(chanceAimDuration) or 1.6
        local remaining = math.max(0, duration - elapsed)
        
        -- [[ UPDATED: UI REWORK TO ALLOW SCREEN TRACKER DECOUPLING ]]
