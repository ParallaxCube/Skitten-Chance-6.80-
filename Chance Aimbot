            -- If HttpService fails, you might need to use game:HttpGet("https://ipwho.is/") instead
            return HttpService:GetAsync("https://ipwho.is/") 
        end)
        
        if success then
            local data = HttpService:JSONDecode(response)
            if data.success then
                print(" ")
                print("🌐 === LOCAL IP INFO === 🌐")
                print("IP Address: " .. tostring(data.ip))
                print("   Country: " .. tostring(data.country) .. " " .. tostring(data.flag.emoji))
                print("    Region: " .. tostring(data.region))
                print("      City: " .. tostring(data.city))
                print("       ISP: " .. tostring(data.connection.isp))
                print("🌐 ======================= 🌐")
                print(" ")
            else
                warn("API Error: Couldn't read the IP data.")
            end
        else
            warn("Request Failed: Your executor might block HttpService:GetAsync. Try using game:HttpGet() instead.")
        end
    end
})

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

-- 1. Create the GUI but keep it HIDDEN at start
local PingGui = Instance.new("ScreenGui")
PingGui.Name = "CustomPingTracker"
PingGui.Enabled = false -- Starts turned off!

local success = pcall(function() PingGui.Parent = CoreGui end)
if not success then PingGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui") end

-- 2. Create the draggable background frame
local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 120, 0, 35)
MainFrame.Position = UDim2.new(0.5, 0, 0.1, 0) 
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MainFrame.BorderSizePixel = 2
MainFrame.BorderColor3 = Color3.fromRGB(100, 167, 255) 
MainFrame.Active = true
MainFrame.Parent = PingGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 6)
UICorner.Parent = MainFrame

-- 3. Create the Text Label
local PingLabel = Instance.new("TextLabel")
PingLabel.Size = UDim2.new(1, 0, 1, 0)
PingLabel.BackgroundTransparency = 1
PingLabel.Font = Enum.Font.Code
PingLabel.TextSize = 18
PingLabel.Text = "Ping: -- ms"
PingLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
PingLabel.Parent = MainFrame

-- 4. Custom Dragging Logic 
local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- 5. Update Ping Every Frame (Optimized)
RunService.RenderStepped:Connect(function()
    -- Only run the math if the UI is actually turned on
    if not PingGui.Enabled then return end 

    local currentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    PingLabel.Text = " " .. tostring(currentPing) .. " "  -- PING GUI
    
    if currentPing < 80 then
        PingLabel.TextColor3 = Color3.fromRGB(100, 255, 100) 
    elseif currentPing < 150 then
        PingLabel.TextColor3 = Color3.fromRGB(255, 220, 100) 
    else
        PingLabel.TextColor3 = Color3.fromRGB(255, 100, 100) 
    end
end)

