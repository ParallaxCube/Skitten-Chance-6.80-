-- THE VAULT LOGIC (Isolated math for legacy engines)
local function LegacyExecuteAim(predicted, dt, elapsed, duration, targetHRP, currentDist)
    if not chancePlayerHRP or not chancePlayerHumanoid then return end 
    
    local hrpPos = chancePlayerHRP.Position 
    local adjustedPredicted = predicted + Vector3.new(0, VerticalOffset, 0) 
    local flatTarget = Vector3.new(adjustedPredicted.X, hrpPos.Y, adjustedPredicted.Z) 
    local targetCF = CFrame.lookAt(hrpPos, flatTarget) 
    local camTargetCF = CFrame.lookAt(camera.CFrame.Position, adjustedPredicted)
    
    local finalHRPAlpha = 0.1
    local finalCAMAlpha = 0.1
    
    if Vault_SelectedEngine == "V16 (Liquid CFrame)" then
        finalHRPAlpha = math.clamp(dt * (1 / HRPSmoothing) * 10, 0, 1)
        finalCAMAlpha = math.clamp(dt * (1 / CAMSmoothing) * 10, 0, 1)
        
    elseif Vault_SelectedEngine == "V14 (Speed Factor Adaptive)" then
        local velocity = targetHRP and targetHRP.AssemblyLinearVelocity.Magnitude or 0
        local sFactor = math.clamp(velocity / 50, 0, 1)
        local adaptiveHRP = HRPSmoothing + (HRPSmoothing * sFactor)
        local adaptiveCAM = CAMSmoothing + (CAMSmoothing * sFactor)
        finalHRPAlpha = math.clamp(adaptiveHRP * dt * 15, 0, 1)
        finalCAMAlpha = math.clamp(adaptiveCAM * dt * 15, 0, 1)
        
    elseif Vault_SelectedEngine == "V13 (Static 0.1 Lerp)" then
        finalHRPAlpha = 0.1
        finalCAMAlpha = 0.1
        
    elseif Vault_SelectedEngine == "V12 (Frame Delta)" then
        finalHRPAlpha = math.clamp(dt * HRPSmoothing * 10, 0, 1)
        finalCAMAlpha = math.clamp(dt * CAMSmoothing * 10, 0, 1)
        
    elseif Vault_SelectedEngine == "V11 (Raw Yaw)" then
        local dir = (predicted - hrpPos).Unit
        local yaw = math.atan2(-dir.X, -dir.Z)
        local rawYawCF = CFrame.new(hrpPos) * CFrame.Angles(0, yaw, 0)
        
        if TargetMode == "Cam" or TargetMode == "ACam" then
            camera.CFrame = CFrame.new(camera.CFrame.Position) * CFrame.Angles(0, yaw, 0)
        else
            chancePlayerHumanoid.AutoRotate = false
            chancePlayerHRP.CFrame = rawYawCF
        end
        return
    end

    if TargetMode == "HRP" then
        chancePlayerHumanoid.AutoRotate = false 
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, finalHRPAlpha)

    elseif TargetMode == "Cam" or TargetMode == "ACam" then
        chancePlayerHumanoid.AutoRotate = true 
        camera.CFrame = camera.CFrame:Lerp(camTargetCF, finalCAMAlpha)

    elseif TargetMode == "Snap" then
        chancePlayerHumanoid.AutoRotate = false 
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)

    elseif TargetMode == "RSnap" or TargetMode == "ACSnap" then
        chancePlayerHumanoid.AutoRotate = false
        local snapForce = MinSnapSpeed + (1 - (currentDist / MaxSnapDistance)) * (1.0 - MinSnapSpeed)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, math.clamp(snapForce, MinSnapSpeed, 1.0))
        if TargetMode == "ACSnap" then 
            camera.CFrame = camera.CFrame:Lerp(camTargetCF, finalCAMAlpha) 
        end

    elseif TargetMode == "AsSnap" then
        chancePlayerHumanoid.AutoRotate = false
        local timeRemaining = duration - elapsed
        if timeRemaining > 0.3 then
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, finalHRPAlpha)
        else
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        end
    end
end

-- ORIGINAL EXECUTION LOGIC (Unmodified from Main 19)
local function ExecuteAim(predicted, dt, elapsed, duration) 
    -- Safety checks
    if not chancePlayerHRP or not chancePlayerHumanoid then return end 
    
    local hrpPos = chancePlayerHRP.Position 
    local adjustedPredicted = predicted + Vector3.new(0, VerticalOffset, 0) 
    
    -- flatTarget removes the Y-axis so your character body doesn't tilt into the floor
    local flatTarget = Vector3.new(adjustedPredicted.X, hrpPos.Y, adjustedPredicted.Z) 
    
    local dist = (hrpPos - flatTarget).Magnitude
    local targetCF = CFrame.lookAt(hrpPos, flatTarget) 

    -- [[ EXECUTE SPECIFIC MODE ]]
    
    if TargetMode == "HRP" then
        -- Gently rotates the character body
        chancePlayerHumanoid.AutoRotate = false 
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, HRPSmoothing)

    elseif TargetMode == "Cam" or TargetMode == "ACam" then
        -- Only manipulates the player's camera perspective
        chancePlayerHumanoid.AutoRotate = true 
        local speedMult = (TargetMode == "ACam") and 1.3 or 1.0 
        local camTargetCF = CFrame.lookAt(camera.CFrame.Position, adjustedPredicted) 
        camera.CFrame = camera.CFrame:Lerp(camTargetCF, (CAMSmoothing * speedMult) * dt * 60)

    elseif TargetMode == "Snap" then
        -- Harsh, immediate snapping
        chancePlayerHumanoid.AutoRotate = false 
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)

    elseif TargetMode == "RSnap" then
        -- Range Snap: Smooth when far, Snaps hard when close
        chancePlayerHumanoid.AutoRotate = false
        local snapForce = MinSnapSpeed + (1 - (dist / MaxSnapDistance)) * (1.0 - MinSnapSpeed)
        snapForce = math.clamp(snapForce, MinSnapSpeed, 1.0)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, snapForce)

    elseif TargetMode == "ACSnap" then
        -- Range Snap for body, but also smoothly moves the camera
        chancePlayerHumanoid.AutoRotate = false
        
        local snapForce = MinSnapSpeed + (1 - (dist / MaxSnapDistance)) * (1.0 - MinSnapSpeed)
        snapForce = math.clamp(snapForce, MinSnapSpeed, 1.0)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, snapForce)
        
        local camTargetCF = CFrame.lookAt(camera.CFrame.Position, adjustedPredicted)
        camera.CFrame = camera.CFrame:Lerp(camTargetCF, CAMSmoothing * dt * 60)

    elseif TargetMode == "AsSnap" then
        -- Advanced Side Snap: Smooth tracking until the final 0.3 seconds, then FLICK
        chancePlayerHumanoid.AutoRotate = false
        local timeRemaining = duration - elapsed
        
        if timeRemaining > 0.3 then
            -- Phase 1: Smooth tracking
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, HRPSmoothing)
        else
            -- Phase 2: The final snapshot
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        end
    end
end

