-- main aim loop
runService.Heartbeat:Connect(function(dt)
    -- 1. Marker/Visual Logic (Distance Labels)
    markerTimer += dt
    if markerTimer >= 0.1 then
        markerTimer = 0
        if killerMarkerEnabled and chancePlayerHRP then
            for _, killer in ipairs(killersFolder:GetChildren()) do
                local hrp = killer:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local marker = killerMarkerFolder:FindFirstChild(killer.Name.."Marker") or createKillerMarker(hrp, killer.Name)
                    local dist = (hrp.Position - chancePlayerHRP.Position).Magnitude
                    if marker:FindFirstChild("DistanceText") then
                        marker.DistanceText.Text = math.floor(dist)
                    end
                    marker.Enabled = (dist > 1 and dist < 100)
                end
            end
        else
            for _, m in ipairs(killerMarkerFolder:GetChildren()) do m.Enabled = false end
        end
    end

    -- 2. Aimbot Logic & Prediction Box
    if not chanceActive or not chancePlayerHRP then 
        predictionMarker.Transparency = 1
        return 
    end

    -- Check if we should start aiming
    if not chanceAiming and (chanceCheckAimAnimation() or forceAimActive) then
        chanceLastTriggerTime = tick()
        chanceAiming = true
    end

    if chanceAiming then
        local elapsed = tick() - chanceLastTriggerTime
        local targetHRP = chanceFindValidTarget()

        -- Check if we should stop aiming
        if not targetHRP or (elapsed > chanceAimDuration and not forceAimActive) then
            chanceAiming = false
            predictionMarker.Transparency = 1
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = true end
            return
        end

        -- Safety Closeness Check
        if (targetHRP.Position - chancePlayerHRP.Position).Magnitude < ChanceClosenesstoDisable then
            predictionMarker.Transparency = 1
            return 
        end

        -- Calculate Prediction
        local predicted = getUnifiedPrediction(targetHRP, TargetMode)
        
        if predicted then
            -- Update Visual Box (MIRROR ROTATION LOGIC)
            if showPredictionBox then
                -- This aligns the box to the predicted position AND the killer's actual rotation
                -- Formula: Position the CFrame at 'predicted', then apply target's rotation offset
                predictionMarker.CFrame = CFrame.new(predicted) * (targetHRP.CFrame - targetHRP.Position)
                predictionMarker.Transparency = 0.5
            else
                predictionMarker.Transparency = 1
            end

            -- Execute Aim
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = false end
            local hrpPos = chancePlayerHRP.Position
            
            if TargetMode == "Snap" then 
                SnapMode(targetHRP, hrpPos, predicted)
            elseif TargetMode == "ASnap" then 
                -- Using your ASnap clamp logic within HRPMode for consistent smoothing
                HRPMode(targetHRP, hrpPos, predicted, dt, math.clamp(HRPSmoothing, 0.15, 0.45))
            elseif TargetMode == "HRP" then 
                HRPMode(targetHRP, hrpPos, predicted, dt)
            elseif TargetMode == "Cam" then 
                CamMode(targetHRP, hrpPos, predicted, dt)
            end
        else
            predictionMarker.Transparency = 1
        end
    else
        -- Hide box if not aiming
        predictionMarker.Transparency = 1
    end
end)
