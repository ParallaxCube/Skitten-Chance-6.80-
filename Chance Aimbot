-- [[ 7. AIM EXECUTION LOGIC (V19 / Vault / VCurve / BackSnap) ]]
-------------------------------------------------------------------------------
local function vcurveEase(t, exp)
    exp = exp or 3
    if t < 0.5 then return 0.5 * (2 * t) ^ exp
    else return 1 - 0.5 * (2 * (1 - t)) ^ exp end
end

-- ── LEGACY ENGINE ─────────────────────────────────────────────────────────
local function LegacyExecuteAim(predicted, dt, elapsed, duration, targetHRP, currentDist)
    if not chancePlayerHRP or not chancePlayerHumanoid then return end
    local hrpPos            = chancePlayerHRP.Position
    local adjustedPredicted = predicted + Vector3.new(0, VerticalOffset, 0)
    local flatTarget        = Vector3.new(adjustedPredicted.X, hrpPos.Y, adjustedPredicted.Z)
    local targetCF          = CFrame.lookAt(hrpPos, flatTarget)
    local camTargetCF       = CFrame.lookAt(camera.CFrame.Position, adjustedPredicted)
    local finalHRPAlpha, finalCAMAlpha = 0.1, 0.1

    if Vault_SelectedEngine == "V16 (Liquid CFrame)" then
        finalHRPAlpha = math.clamp(dt * (1 / HRPSmoothing) * 10, 0, 1)
        finalCAMAlpha = math.clamp(dt * (1 / CAMSmoothing) * 10, 0, 1)
    elseif Vault_SelectedEngine == "V14 (Speed Factor Adaptive)" then
        local vel = targetHRP and targetHRP.AssemblyLinearVelocity.Magnitude or 0
        local sf  = math.clamp(vel / 50, 0, 1)
        finalHRPAlpha = math.clamp((HRPSmoothing + HRPSmoothing * sf) * dt * 15, 0, 1)
        finalCAMAlpha = math.clamp((CAMSmoothing + CAMSmoothing * sf) * dt * 15, 0, 1)
    elseif Vault_SelectedEngine == "V13 (Static 0.1 Lerp)" then
        finalHRPAlpha, finalCAMAlpha = 0.1, 0.1
    elseif Vault_SelectedEngine == "V12 (Frame Delta)" then
        finalHRPAlpha = math.clamp(dt * HRPSmoothing * 10, 0, 1)
        finalCAMAlpha = math.clamp(dt * CAMSmoothing * 10, 0, 1)
    elseif Vault_SelectedEngine == "V11 (Raw Yaw)" then
        local dir = (predicted - hrpPos).Unit
        local yaw = math.atan2(-dir.X, -dir.Z)
        if TargetMode == "Cam" or TargetMode == "ACam" then
            camera.CFrame = CFrame.new(camera.CFrame.Position) * CFrame.Angles(0, yaw, 0)
        else
            chancePlayerHumanoid.AutoRotate = false
            chancePlayerHRP.CFrame = CFrame.new(hrpPos) * CFrame.Angles(0, yaw, 0)
        end
        return
    end

    if TargetMode == "HRP" then
        chancePlayerHumanoid.AutoRotate = false
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, finalHRPAlpha)
    elseif TargetMode == "Cam" or TargetMode == "ACam" then
        chancePlayerHumanoid.AutoRotate = true
        camera.CFrame = camera.CFrame:Lerp(camTargetCF, finalCAMAlpha)
    elseif TargetMode == "Snap" then
        chancePlayerHumanoid.AutoRotate = false
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
    elseif TargetMode == "RSnap" or TargetMode == "ACSnap" then
        chancePlayerHumanoid.AutoRotate = false
        local sf = math.clamp(MinSnapSpeed + (1 - (currentDist / MaxSnapDistance)) * (1 - MinSnapSpeed), MinSnapSpeed, 1)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, sf)
        if TargetMode == "ACSnap" then camera.CFrame = camera.CFrame:Lerp(camTargetCF, finalCAMAlpha) end
    elseif TargetMode == "AsSnap" then
        chancePlayerHumanoid.AutoRotate = false
        if (duration - elapsed) > 0.3 then
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, finalHRPAlpha)
        else
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        end
    elseif TargetMode == "VCurve" then
        chancePlayerHumanoid.AutoRotate = false
        local t        = math.clamp(elapsed / duration, 0, 1)
        local curve    = vcurveEase(t, VCurve_CurveExp)
        local vel      = targetHRP and targetHRP.AssemblyLinearVelocity.Magnitude or 0
        local vb       = math.clamp(1 + (vel / 30) * VCurve_VelScale, 1, 3)
        local tLeft    = duration - elapsed
        if (tLeft / duration) <= VCurve_EarlySnapPct then
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        else
            local a = math.clamp(finalHRPAlpha * vb * curve * VCurve_HRPWeight * 15, 0, 1)
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, a)
        end
    elseif TargetMode == "BackSnap" then
        -- Phase 1: look AWAY from killer (sneaky mode)
        -- Phase 2: 180-degree snap to face killer and shoot
        chancePlayerHumanoid.AutoRotate = false
        local toKiller   = (flatTarget - hrpPos)
        local awayTarget = hrpPos - toKiller.Unit * 10
        local awayCF     = CFrame.lookAt(hrpPos, awayTarget)
        if (duration - elapsed) > BackSnap_SnapWindow then
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(awayCF, finalHRPAlpha)
        else
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        end
    end
end

-- ── PRIMARY ENGINE ────────────────────────────────────────────────────────
local function ExecuteAim(predicted, dt, elapsed, duration)
    if not chancePlayerHRP or not chancePlayerHumanoid then return end
    local hrpPos            = chancePlayerHRP.Position
    local adjustedPredicted = predicted + Vector3.new(0, VerticalOffset, 0)
    local flatTarget        = Vector3.new(adjustedPredicted.X, hrpPos.Y, adjustedPredicted.Z)
    local dist              = (hrpPos - flatTarget).Magnitude
    local targetCF          = CFrame.lookAt(hrpPos, flatTarget)
    local camTargetCF       = CFrame.lookAt(camera.CFrame.Position, adjustedPredicted)

    if TargetMode == "HRP" then
        chancePlayerHumanoid.AutoRotate = false
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, HRPSmoothing)
    elseif TargetMode == "Cam" or TargetMode == "ACam" then
        chancePlayerHumanoid.AutoRotate = true
        local sm = (TargetMode == "ACam") and 1.3 or 1.0
        camera.CFrame = camera.CFrame:Lerp(camTargetCF, CAMSmoothing * sm * dt * 60)
    elseif TargetMode == "Snap" then
        chancePlayerHumanoid.AutoRotate = false
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
    elseif TargetMode == "RSnap" then
        chancePlayerHumanoid.AutoRotate = false
        local sf = math.clamp(MinSnapSpeed + (1 - (dist / MaxSnapDistance)) * (1 - MinSnapSpeed), MinSnapSpeed, 1)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, sf)
    elseif TargetMode == "ACSnap" then
        chancePlayerHumanoid.AutoRotate = false
        local sf = math.clamp(MinSnapSpeed + (1 - (dist / MaxSnapDistance)) * (1 - MinSnapSpeed), MinSnapSpeed, 1)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, sf)
        camera.CFrame = camera.CFrame:Lerp(camTargetCF, CAMSmoothing * dt * 60)
    elseif TargetMode == "AsSnap" then
        chancePlayerHumanoid.AutoRotate = false
        if (duration - elapsed) > 0.3 then
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, HRPSmoothing)
        else
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        end
    elseif TargetMode == "VCurve" then
        chancePlayerHumanoid.AutoRotate = false
        local t      = math.clamp(elapsed / duration, 0, 1)
        local curve  = vcurveEase(t, VCurve_CurveExp)
        local vHRP   = chanceFindValidTarget()
        local velMag = (vHRP and vHRP.AssemblyLinearVelocity.Magnitude) or 0
        local vb     = math.clamp(1 + (velMag / 30) * VCurve_VelScale, 1, 3)
        local tLeft  = duration - elapsed
        if (duration > 0) and ((tLeft / duration) <= VCurve_EarlySnapPct) then
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        else
            local a = math.clamp(HRPSmoothing * vb * curve * VCurve_HRPWeight * 15 * dt, 0, 1)
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, a)
        end
    elseif TargetMode == "BackSnap" then
        -----------------------------------------------------------------------
        -- BackSnap: "look-cool" mode
        --   Phase 1 – character smoothly rotates to face AWAY from the killer.
        --             Your gun is charging but they can't see it pointing at them.
        --   Phase 2 – when the snap window opens, character whips 180 degrees
        --             to face the killer with full SnapPower and commits the shot.
        --   Camera  – never touched; stays wherever you're looking.
        -----------------------------------------------------------------------
        chancePlayerHumanoid.AutoRotate = false
        local toKiller   = (flatTarget - hrpPos)
        local awayTarget = hrpPos - toKiller.Unit * 10   -- point directly behind player
        local awayCF     = CFrame.lookAt(hrpPos, awayTarget)
        if (duration - elapsed) > BackSnap_SnapWindow then
            -- Look away (smooth, using HRPSmoothing)
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(awayCF, HRPSmoothing)
        else
            -- 180 snap to face killer
            chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower)
        end
    end
