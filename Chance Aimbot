-- [[ 10. MAIN EXECUTION LOOPS ]]
-------------------------------------------------------------------------------
runService.RenderStepped:Connect(function()
    if not chanceActive or not chancePlayerHumanoid or not chancePlayerHRP then return end
    if not chanceAiming and chanceCheckAimAnimation() then
        chanceLastTriggerTime    = tick()
        chanceAiming             = true
        chanceOriginalWS         = chancePlayerHumanoid.WalkSpeed
        chanceOriginalAutoRotate = chancePlayerHumanoid.AutoRotate
    end
end)

local hudUpdateTimer = 0
local framesRendered = 0
local markerTimer    = 0
local speedTimer     = 0

runService.Heartbeat:Connect(function(dt)

    -- HUD (ping / fps) every 0.5s
    framesRendered += 1
    hudUpdateTimer += dt
    if hudUpdateTimer >= 0.5 then
        local fps = math.floor(framesRendered / hudUpdateTimer)
        framesRendered = 0
        hudUpdateTimer = 0
        if PingBox.Visible or FpsBox.Visible then
            local ping = math.floor(statsService.Network.ServerStatsItem["Data Ping"]:GetValue())
            if PingBox.Visible then
                PingText.Text        = "Ping: " .. ping
                PingBox.BorderColor3 = (ping > 150) and HUDColors.Bad or HUDColors.Good
                PingText.TextColor3  = PingBox.BorderColor3
            end
            if FpsBox.Visible then
                FpsText.Text        = "FPS: " .. fps
                FpsBox.BorderColor3 = (fps < 30) and HUDColors.Bad or HUDColors.Good
                FpsText.TextColor3  = FpsBox.BorderColor3
            end
        end
    end

    -- Speed box update every 0.1s
    speedTimer += dt
    if speedTimer >= 0.1 then
        speedTimer = 0
        if SpeedBox.Visible and chancePlayerHRP then
            local spd = chancePlayerHRP.AssemblyLinearVelocity.Magnitude
            SpeedText.Text = string.format("%.1f studs/s", spd)
            SpeedText.TextColor3 = (spd > 25) and Color3.fromRGB(255, 200, 50)
                or Color3.fromRGB(100, 255, 150)
        end
    end

    -- TPWalk
    if tpWalkEnabled and chancePlayerHumanoid and chancePlayerHRP
        and chancePlayerHumanoid.MoveDirection.Magnitude > 0 then
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame
            + (chancePlayerHumanoid.MoveDirection * tpWalkSpeed)
    end

    local kFolder = getKillersFolder()
    local localName = playersService.LocalPlayer.Name

    -- ESP loop every 0.1s
    markerTimer += dt
    if markerTimer >= 0.1 then
        markerTimer = 0

        -- Killer ESP
        if kFolder then
            for _, killer in ipairs(kFolder:GetChildren()) do
                if killer.Name ~= localName then   -- never ESP yourself
                    local hrp = killer:FindFirstChild("HumanoidRootPart")
                    if hrp and chancePlayerHRP then
                        local marker    = killerMarkerFolder:FindFirstChild(killer.Name.."Marker")
                        local highlight = killerMarkerFolder:FindFirstChild(killer.Name.."Highlight")
                        if not marker then
                            marker, highlight = createESP(
                                killer, killer.Name, killerMarkerFolder,
                                ESPColor, KillerFillAlpha,
                                ESPColor, KillerOutlineAlpha)
                        end
                        if marker and highlight then
                            local dist = (hrp.Position - chancePlayerHRP.Position).Magnitude
                            marker.DistanceText.Text      = math.floor(dist)
                            marker.DistanceText.TextColor3 = ESPColor
                            marker.Enabled    = dist > 1 and dist < 500 and killerESPEnabled
                            highlight.Enabled = dist > 1 and dist < 500 and killerESPEnabled
                            highlight.FillColor    = ESPColor
                            highlight.OutlineColor = ESPColor
                            highlight.FillTransparency    = KillerFillAlpha
                            highlight.OutlineTransparency = KillerOutlineAlpha
                        end
                    end
                end
            end
        end

        -- Survivor / Player ESP
        for _, player in ipairs(playersService:GetPlayers()) do
            if player ~= playersService.LocalPlayer and player.Character then
                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp and chancePlayerHRP and not table.find(chanceAimTargets, player.Name) then
                    local marker    = playerMarkerFolder:FindFirstChild(player.Name.."Marker")
                    local highlight = playerMarkerFolder:FindFirstChild(player.Name.."Highlight")
                    if not marker then
                        marker, highlight = createESP(
                            player.Character, player.Name, playerMarkerFolder,
                            PlayerESPColor, PlayerFillAlpha,
                            PlayerESPColor, PlayerOutlineAlpha)
                    end
                    if marker and highlight then
                        local dist = (hrp.Position - chancePlayerHRP.Position).Magnitude
                        marker.DistanceText.Text       = math.floor(dist)
                        marker.DistanceText.TextColor3 = PlayerESPColor
                        marker.Enabled    = dist > 1 and dist < 500 and playerESPEnabled
                        highlight.Enabled = dist > 1 and dist < 500 and playerESPEnabled
                        highlight.FillColor    = PlayerESPColor
                        highlight.OutlineColor = PlayerESPColor
                        highlight.FillTransparency    = PlayerFillAlpha
                        highlight.OutlineTransparency = PlayerOutlineAlpha
                    end
                end
            end
        end
    end

    -- Pre-aim gate
    if not chanceActive or not chancePlayerHRP then
        predictionMarker.Transparency = 1
        safetySphere.Transparency     = 1
        MainBar.Visible    = false
        AimBox.Visible     = false
        DandyFrame.Visible = false
        return
    end

    local targetHRP = chanceFindValidTarget()

    if targetHRP and showSafetySphere and (ChanceClosenesstoDisArm or 0) > 0 then
        safetySphere.Size = Vector3.new(
            ChanceClosenesstoDisArm*2, ChanceClosenesstoDisArm*2, ChanceClosenesstoDisArm*2)
        safetySphere.CFrame       = targetHRP.CFrame
        safetySphere.Transparency = 0.2
    else
        safetySphere.Transparency = 1
    end

    local predicted = targetHRP and getUnifiedPrediction(targetHRP) or nil

    if not chanceAiming and forceAimActive then
        chanceLastTriggerTime = tick()
        chanceAiming          = true
    end

    if predicted and (alwaysShowPredictionBox or (showPredictionBox and chanceAiming)) then
        predictionMarker.CFrame       = CFrame.new(predicted + Vector3.new(0, VerticalOffset or 0, 0))
        predictionMarker.Transparency = predBoxTransparency or 0.5
    else
        predictionMarker.Transparency = 1
    end

    -- Aim execution frame
    if chanceAiming and predicted then
        local elapsed   = tick() - chanceLastTriggerTime
        local duration  = tonumber(chanceAimDuration) or 1.6
        local remaining = math.max(0, duration - elapsed)
        local progress  = remaining / duration
        local dist      = (targetHRP.Position - chancePlayerHRP.Position).Magnitude

        -- Progress bar (centre)
        if showProgressBar then
            MainBar.Visible  = true
            ProgressBar.Size = UDim2.new(progress, 0, 1, 0)
        else MainBar.Visible = false end

        -- Classic screen box
        if showAimTimerScreen then
            AimBox.Visible   = true
            AimBarInner.Size = UDim2.new(progress, -10, 0, 2)
            if AimText then AimText.Text = string.format("LOCKED: %.1fs", remaining) end
        else AimBox.Visible = false end

        -- Dandy Bar (top-left rainbow)
        if showDandyBar and chanceAiming then
            DandyFrame.Visible    = true
            DandyText.Text        = string.format("LOCKED: %.1fs", remaining)
            DandyBarFill.Size     = UDim2.new(progress, 0, 1, 0)
        else
            DandyFrame.Visible = false
        end

        -- ESP lock timer text
        if showAimTimerESP and targetHRP and targetHRP.Parent then
            local m = killerMarkerFolder:FindFirstChild(targetHRP.Parent.Name.."Marker")
            if m and m:FindFirstChild("LockDurationText") then
                m.LockDurationText.Text    = string.format("LOCKED: %.1fs", remaining)
                m.LockDurationText.Visible = true
            end
        end

        -- Disarm / expire check
        if not targetHRP
            or (remaining <= 0 and not forceAimActive)
            or (dist < (ChanceClosenesstoDisArm or 0) and not Vault_InfiniteRange)
        then
            chanceAiming       = false
            MainBar.Visible    = false
            AimBox.Visible     = false
            DandyFrame.Visible = false
            if chancePlayerHumanoid then chancePlayerHumanoid.AutoRotate = chanceOriginalAutoRotate end
            for _, m in ipairs(killerMarkerFolder:GetChildren()) do
                if m:IsA("BillboardGui") and m:FindFirstChild("LockDurationText") then
                    m.LockDurationText.Visible = false
                end
            end
            return
        end

        if (dist >= (ChanceClosenesstoDisArm or 0) and dist <= AimFOV) or Vault_InfiniteRange then
            if tick() - chanceLastTriggerTime >= ReactionDelay then
                if Vault_EnableLegacy then
                    LegacyExecuteAim(predicted, dt, elapsed, duration, targetHRP, dist)
                else
                    ExecuteAim(predicted, dt, elapsed, duration)
                end
            end
        end
    else
        MainBar.Visible    = false
        AimBox.Visible     = false
        DandyFrame.Visible = false
        for _, m in ipairs(killerMarkerFolder:GetChildren()) do
            if m:IsA("BillboardGui") and m:FindFirstChild("LockDurationText") then
                m.LockDurationText.Visible = false
            end
        end
    end
end)

