-- 1. Snap: Instant snap to target on the XZ plane
local function SnapMode(targetHRP, hrpPos, predicted)
    local targetLookPos = Vector3.new(predicted.X, hrpPos.Y, predicted.Z)
    chancePlayerHRP.CFrame = CFrame.lookAt(hrpPos, targetLookPos)
end

-- 2. ASnap: The "Weighted" snap (uses a specific clamp for that v6 feel)
local function ASnapMode(targetHRP, hrpPos, predicted)
    local targetLookPos = Vector3.new(predicted.X, hrpPos.Y, predicted.Z)
    local targetCFrame = CFrame.lookAt(hrpPos, targetLookPos)
    -- This specific clamp (0.15 - 0.45) provides the "weighted" snap feel
    chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCFrame, math.clamp(HRPSmoothing, 0.15, 0.45))
end

-- 3. HRP: Traditional smooth character rotation
local function HRPMode(targetHRP, hrpPos, predicted, dt)
    local targetLookPos = Vector3.new(predicted.X, hrpPos.Y, predicted.Z)
    local targetCFrame = CFrame.lookAt(hrpPos, targetLookPos)
    chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCFrame, math.min(HRPSmoothing * dt * 60, 1))
end

-- 4. Cam: Standard smooth camera movement
local function CamMode(targetHRP, hrpPos, predicted, dt)
    local camPos = camera.CFrame.Position
    local targetCF = CFrame.lookAt(camPos, predicted)
    camera.CFrame = camera.CFrame:Lerp(targetCF, math.min(CAMSmoothing * dt * 60, 1))
end

-- 5. ACam: Advanced Camera (targets predicted center with weighted smoothing)
local function ACamMode(targetHRP, hrpPos, predicted, dt)
    local camPos = camera.CFrame.Position
    local targetCF = CFrame.lookAt(camPos, predicted)
    -- ACam uses a slightly tighter interpolation for high-speed tracking
    camera.CFrame = camera.CFrame:Lerp(targetCF, math.min((CAMSmoothing * 1.1) * dt * 60, 1))
end



-- [[ 6. EXECUTION LOGIC ]]
-- [[ 6. EXECUTION DISPATCHER ]]
-- [[ 6. PRECISION EXECUTION ]]
-- [[ 6. UPDATED X-LOCK ACCURACY DISPATCH ]]
-- [[ 6. PURE ACCURACY DISPATCH ]]
local function ExecuteAim(predicted, dt)
    if not chancePlayerHRP or not chancePlayerHumanoid then return end
    
    local hrpPos = chancePlayerHRP.Position
    -- Apply Vertical Offset: Adjusts the 'center' of the target for your gun height
    local adjustedPredicted = predicted + Vector3.new(0, VerticalOffset or 0, 0)
    
    -- THE X-LOCK: This forces the aimbot to ONLY rotate left/right.
    -- We use the predicted X and Z, but keep the Y the same as your character.
    local flatTarget = Vector3.new(adjustedPredicted.X, hrpPos.Y, adjustedPredicted.Z)

    if TargetMode == "Snap" then
        -- Frame-1 Instant alignment. 
        chancePlayerHumanoid.AutoRotate = false
        local targetCF = CFrame.lookAt(hrpPos, flatTarget)
        -- Power 1.0 = Instant. Power 0.8 = Micro-smoothing (better for high-speed targets)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, SnapPower or 1)

    elseif TargetMode == "ASnap" then
        -- Weighted Accuracy: Stays locked but absorbs jitter.
        chancePlayerHumanoid.AutoRotate = false
        local targetCF = CFrame.lookAt(hrpPos, flatTarget)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, math.clamp(HRPSmoothing, 0.15, 0.45))

    elseif TargetMode == "HRP" then
        -- Smooth Character Body rotation.
        chancePlayerHumanoid.AutoRotate = false
        local targetCF = CFrame.lookAt(hrpPos, flatTarget)
        chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(targetCF, math.min(HRPSmoothing * dt * 60, 1))

    elseif TargetMode == "Cam" or TargetMode == "ACam" then
        -- Camera Tracking: Character stays free for Shiftlock.
        chancePlayerHumanoid.AutoRotate = true
        local speedMult = (TargetMode == "ACam") and 1.3 or 1.0
        local targetCF = CFrame.lookAt(camera.CFrame.Position, adjustedPredicted)
        
        camera.CFrame = camera.CFrame:Lerp(targetCF, math.min((CAMSmoothing * speedMult) * dt * 60, 1))
    end
end

