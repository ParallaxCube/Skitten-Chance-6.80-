-- [[ 8. STABILIZED PREDICTION ENGINE]]
local statsService = game:GetService("Stats")

local smoothedPing = 0.1
local function getPing()
    local raw = 0.1
    pcall(function()
        raw = statsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)

    smoothedPing = smoothedPing + (raw - smoothedPing) * 0.15
    return math.clamp(smoothedPing, 0.03, 0.2)
end

local function getUnifiedPrediction(targetHRP, mode)
    if not targetHRP or not chancePlayerHRP then 
        return targetHRP and targetHRP.Position or nil 
    end

    local velocity = targetHRP.AssemblyLinearVelocity
    local latency = getPing()

    -- stop micro jitter
    if velocity.Magnitude < 1.5 then
        return targetHRP.Position
    end

    local predicted = targetHRP.Position + (velocity * latency)

    -- reduce overflick (VERY IMPORTANT)
    predicted = predicted:Lerp(targetHRP.Position, 0.1)

    return predicted
end
