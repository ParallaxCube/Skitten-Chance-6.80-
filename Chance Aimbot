-- Gets and smooths the network ping
local smoothedPing = 0
local function getPing()
    local raw = 0
    pcall(function() 
        raw = statsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000 
    end)
    
    -- Option to bypass smoothing if you want raw data
    if useRawPing then return raw end
    
    smoothedPing = smoothedPing + (raw - smoothedPing) * 0.15
    return math.clamp(smoothedPing, 0.03, 0.2)
end

