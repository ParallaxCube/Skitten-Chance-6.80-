local kFolder = getKillersFolder()

runService.Heartbeat:Connect(function(dt)
    if not kFolder or not kFolder.Parent then
        kFolder = getKillersFolder()
    end
    
    if not kFolder then return end
    
    markerTimer += dt
    if markerTimer >= 0.1 then
        markerTimer = 0
        if killerMarkerEnabled and chancePlayerHRP then
            for _, killer in ipairs(kFolder:GetChildren()) do
                local hrp = killer:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local marker = killerMarkerFolder:FindFirstChild(killer.Name.."Marker") or createKillerMarker(hrp, killer.Name)
                    local dist = (hrp.Position - chancePlayerHRP.Position).Magnitude
                    marker.DistanceText.Text = math.floor(dist)
                    marker.Enabled = (dist > 1 and dist < 100)
                end
            end
        end
    end

    local uiComponentsReady = (MainBar ~= nil and AimBox ~= nil and predictionMarker ~= nil)

    if not chanceActive or not chancePlayerHRP then 
        if predictionMarker then 
            predictionMarker.Transparency = 1 
        end
        if safetySphere then
            safetySphere.Transparency = 1
        end
        
        if uiComponentsReady then
            MainBar.Visible = false
            AimBox.Visible = false
        end
        return 
    end

    local targetHRP = chanceFindValidTarget()
    
    -- [[ ADDED: SAFETY SPHERE UPDATE ALIGNMENT ]]
    if targetHRP and showSafetySphere and (ChanceClosenesstoDisArm or 0) > 0 then
        -- Multiplied by 2 because Size is the Diameter, but Distance is the Radius
        safetySphere.Size = Vector3.new(ChanceClosenesstoDisArm * 2, ChanceClosenesstoDisArm * 2, ChanceClosenesstoDisArm * 2)
        safetySphere.CFrame = targetHRP.CFrame
        safetySphere.Transparency = 0.2 -- Exact 0.2 transparency you requested
    else
        if safetySphere then safetySphere.Transparency = 1 end
    end
    -- [[ END OF SPHERE LOGIC ]]

    local predicted = nil
    if targetHRP and getUnifiedPrediction then
        predicted = getUnifiedPrediction(targetHRP, TargetMode)
    end

    if not chanceAiming and (chanceCheckAimAnimation() or forceAimActive) then
