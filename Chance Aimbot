local HUDColors = { Good = Color3.fromRGB(100, 255, 100), Bad = Color3.fromRGB(255, 100, 100) }
local function updateSpoofedHUD()
    if PingBox.Visible or FpsBox.Visible then
        local ping = 0
        local fps = 60
        if SpoofMode == "Ping" then
            ping = SpoofedPingValue + math.random(-randomPingVariance, randomPingVariance)
            fps = math.random(55, 65)
        elseif SpoofMode == "FPS" then
            ping = math.random(40, 60)
            fps = SpoofedFPSValue + math.random(-randomFPSVariance, randomFPSVariance)
        elseif SpoofMode == "LagSwitch" then
            ping = isLagSwitchActive and math.random(800, 2000) or math.random(40, 60)
            fps = math.random(55, 65)
        end
        if PingBox.Visible then  
            PingText.Text = "Ping: " .. math.floor(ping) 
            PingBox.BorderColor3 = (ping > 150) and HUDColors.Bad or HUDColors.Good
            PingText.TextColor3 = PingBox.BorderColor3
        end 
        if FpsBox.Visible then   
            FpsText.Text = "FPS: " .. math.floor(fps) 
            FpsBox.BorderColor3 = (fps < 30) and HUDColors.Bad or HUDColors.Good
            FpsText.TextColor3 = FpsBox.BorderColor3
        end 
    end
end

