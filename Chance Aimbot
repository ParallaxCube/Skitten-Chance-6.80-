-- [[ 7. STABILIZED PREDICTION ENGINE ]]
local function getUnifiedPrediction(targetHRP, mode)
    if not targetHRP or not chancePlayerHRP then return targetHRP and targetHRP.Position or nil end
    
    -- Fetch Ping
    local ping = statsService.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    
    -- Get Mode-specific offset
    local modeOffset = (mode == "Snap" and (pingPredictionSnap or 0)) 
                    or (mode == "HRP" and (pingPredictionHRP or 0)) 
                    or (mode == "Cam" and (pingPredictionCam or 0)) 
                    or (mode == "ASnap" and (pingPredictionASnap or 0)) 
                    or 0
    
    local latency = ping + modeOffset
    local velocity = targetHRP.AssemblyLinearVelocity
    
    -- Movement Threshold Guard
    if velocity.Magnitude < (chanceMovementThreshold or 0.7) then 
        return targetHRP.Position 
    end

    local predicted = targetHRP.Position + (velocity * latency)

    -- Extra Custom Studs logic
    if extraStuds and extraStuds > 0 then
        predicted = predicted + (velocity.Unit * extraStuds)
    end

    return predicted
end

