-- Setup character references
local function chanceConfigureCharacter(char)
    chancePlayerHumanoid = char:FindFirstChild("Humanoid")
    chancePlayerHRP = char:FindFirstChild("HumanoidRootPart")
end

if playersService.LocalPlayer.Character then
    chanceConfigureCharacter(playersService.LocalPlayer.Character) 
end

playersService.LocalPlayer.CharacterAdded:Connect(chanceConfigureCharacter)

-- Find valid killer target
local function chanceFindValidTarget()
 local killersFolder = workspaceService:FindFirstChild("Players") and workspaceService.Players:FindFirstChild("Killers")
-- BAD local killersFolder = workspaceService:WaitForChild("Players"):WaitForChild("Killers")
-- beta above
    if not killersFolder then
        return nil
    end
    
    for _, name in ipairs(chanceAimTargets) do
        local target = killersFolder:FindFirstChild(name)
        if target and target:FindFirstChild("HumanoidRootPart") then
            return target.HumanoidRootPart
        end
    end
    return nil
end


-- Ping-based prediction with optional extra lead
local function chancePredictPosition(targetHRP)
    if not targetHRP then return nil end

    -- Get ping compensation
    local pingMs = statsService.Network.ServerStatsItem["Data Ping"]:GetValue()
    local latencySeconds = pingMs / 1000 + PingpredictionAddedSeconds
    local velocity = targetHRP.AssemblyLinearVelocity or targetHRP.Velocity
   -- local velocity = targetHRP.AssemblyLinearVelocity

    if velocity.Magnitude > chanceMovementThreshold then
        -- Ping-based prediction
        local pingPrediction = targetHRP.Position + (velocity * latencySeconds)
        
        -- Add extra manual prediction based on dropdown selection
        
        -- Beta
        local extraStuds

if chancePredictionMode == "Custom + Ping" then
    extraStuds = CustomStudsAddedToPing
else
    extraStuds = chancePredictionModes[chancePredictionMode] or 0
end
-- beta

local direction = velocity.Magnitude > 0 and velocity.Unit or Vector3.zero
--
local finalPrediction = pingPrediction + (direction * extraStuds)
--
        return finalPrediction
    end
    
    return targetHRP.Position
end

-- Detect aim animation start
local function chanceCheckAimAnimation()
    if not chancePlayerHumanoid or chanceActiveTrack then
        return false
    end

    for _, track in ipairs(chancePlayerHumanoid:GetPlayingAnimationTracks()) do
        local id = track.Animation.AnimationId:match("%d+")
        if id and table.find(chanceAimAnimationIds, id) then
            chanceActiveTrack = track
            track.Stopped:Once(function()
                chanceActiveTrack = nil
            end)
            return true
        end
    end
    return false
end

-- Main aim loop
-- Main aim loop \/  \/  \/
runService.RenderStepped:Connect(function()
    -- Early exit if not aiming or missing required references
 if not chanceActive 
  or not chancePlayerHumanoid 
   or not chancePlayerHRP 
    then
   if chanceAiming then
 chanceAiming = false
   if chanceOriginalWS and chanceOriginalAutoRotate ~= nil then
                      chancePlayerHumanoid.WalkSpeed = chanceOriginalWS
                    chancePlayerHumanoid.AutoRotate = chanceOriginalAutoRotate
        chanceOriginalWS, chanceOriginalAutoRotate = nil, nil
end
  end
  return
      end 

    -- Start aiming if the animation is playing
    if not chanceAiming and chanceCheckAimAnimation() then
        chanceLastTriggerTime = tick()
        chanceAiming = true
        chanceOriginalWS = chancePlayerHumanoid.WalkSpeed
        chanceOriginalAutoRotate = chancePlayerHumanoid.AutoRotate
    end

    -- If already aiming, continue
    if chanceAiming then
        local elapsed = tick() - chanceLastTriggerTime
        local targetHRP = chanceFindValidTarget()

        -- Stop aiming if conditions are met
        if not targetHRP or (targetHRP.Position - chancePlayerHRP.Position).Magnitude < ChanceClosenesstoDisable or elapsed > chanceAimDuration then
            chanceAiming = false
            if chanceOriginalWS and chanceOriginalAutoRotate ~= nil then
                chancePlayerHumanoid.WalkSpeed = chanceOriginalWS
                chancePlayerHumanoid.AutoRotate = chanceOriginalAutoRotate
                chanceOriginalWS, chanceOriginalAutoRotate = nil, nil
            end
            return
        end

        -- Disable auto-rotate and angular velocity while aiming
        chancePlayerHumanoid.AutoRotate = false
        chancePlayerHRP.AssemblyAngularVelocity = Vector3.zero

        -- Predict target position and aim
        local predicted = chancePredictPosition(targetHRP)
if not predicted then return end

local hrpPos = chancePlayerHRP.Position

if TargetMode == "SNAP" then
    
    local lookCF = CFrame.lookAt(hrpPos, Vector3.new(predicted.X, hrpPos.Y, predicted.Z))
    chancePlayerHRP.CFrame = lookCF

elseif TargetMode == "HRP" then
    
    local lookCF = CFrame.lookAt(hrpPos, Vector3.new(predicted.X, hrpPos.Y, predicted.Z))
    chancePlayerHRP.CFrame = chancePlayerHRP.CFrame:Lerp(lookCF, HRPSmoothing)

elseif TargetMode == "CAM" then
    
    local camCF = camera.CFrame
    local lookCF = CFrame.lookAt(camCF.Position, predicted)
    camera.CFrame = camCF:Lerp(lookCF, CAMSmoothing)

end
    end
end)

-- the end of main aim loop













